#version 450
#extension GL_GOOGLE_include_directive : require
#define TIED_EMBEDDING_Q40_HIDDEN_INPUT
#include "tied-embedding-q40.glsl"

// Eight vocabulary rows by four canvas positions, reduced over 16 block lanes.
// Reuse each decoded Q40 block across the four Q80 inputs.
layout(local_size_x = 128) in;
shared vec4 sums[128];

void main() {
    const uint lane = gl_LocalInvocationID.x;
    const uint row = lane / 16u;
    const uint blockLane = lane % 16u;
    const uint token = gl_WorkGroupID.x * 8u + row;
    const uint batch = gl_WorkGroupID.y * 4u;
    const uint blocks = HIDDEN_SIZE / 32u;
    vec4 sum = vec4(0.0f);
    if (token < infos[batch].outputSizeX) {
        for (uint k = blockLane; k < blocks; k += 16u) {
            const BlockQ40 w = embedding[token * blocks + k];
            for (uint b = 0u; b < 4u; ++b) {
                if (batch + b >= batchSize)
                    continue;
                const BlockQ80 x = hidden[infos[batch + b].inputOffset + k];
                int dotValue = 0;
                for (uint i = 0u; i < 16u; ++i) {
                    const uint packed = w.qs[i];
                    dotValue += (int(packed & 15u) - 8) * int(x.qs[i]);
                    dotValue += (int(packed >> 4u) - 8) * int(x.qs[i + 16u]);
                }
                sum[b] += float(dotValue) * float(w.d) * float(x.d);
            }
        }
    }
    sums[lane] = sum;
    barrier();
    for (uint stride = 8u; stride > 0u; stride >>= 1u) {
        if (blockLane < stride)
            sums[lane] += sums[lane + stride];
        barrier();
    }
    if (blockLane == 0u && token < infos[batch].outputSizeX)
        for (uint b = 0u; b < 4u; ++b)
            if (batch + b < batchSize)
                logits[infos[batch + b].outputOffset + token] =
                    logitSoftcap * tanh(sums[lane][b] / logitSoftcap);
}
