#version 450

#define N_THREADS 32

layout(local_size_x = N_THREADS, local_size_y = 1, local_size_z = 1) in;

layout(constant_id = 0) const uint N_BATCHES = 32;
layout(constant_id = 1) const uint TILE_COUNT = 1;

struct BatchInfo {
    uint inputOffset;
    uint inputSizeX;
    uint outputOffset;
    uint outputSizeX;
};

layout(binding = 0) readonly buffer inputBuffer { float partials[]; };
layout(binding = 1) writeonly buffer maximumBuffer { float vocabularyMaximum[]; };
layout(binding = 2) readonly uniform batchInfosBuffer { BatchInfo infos[N_BATCHES]; };
layout(binding = 3) readonly uniform configBuffer {
    uint mode;
    uint embeddingMixBufferIndex;
    uint vocabularyMaxPipeIndex;
    uint globalMaxBufferIndex;
    uint temperaturePipeIndex;
    uint nodeIndex;
    uint nNodes;
    uint physicalSize;
    float embeddingScale;
    float logitSoftcap;
    uint useTemperature;
    uint partialBufferIndex;
    uint tileSize;
    uint tileCount;
    uint hiddenSize;
};
layout(binding = 4) writeonly buffer outputBuffer { float outputValues[]; };

shared float tileScales[TILE_COUNT];
shared float maximum;

void main() {
    const uint batch = gl_WorkGroupID.y;
    const uint lane = gl_LocalInvocationID.x;
    const BatchInfo info = infos[batch];
    const uint mixOffset = batch * physicalSize;

    if (lane == 0u) {
        maximum = -3.402823466e+38f;
        for (uint tile = 0u; tile < tileCount; ++tile)
            maximum = max(maximum,
                partials[info.inputOffset + tile * physicalSize + hiddenSize + 1u]);
    }
    barrier();

    for (uint tile = lane; tile < tileCount; tile += N_THREADS) {
        const float tileMaximum =
            partials[info.inputOffset + tile * physicalSize + hiddenSize + 1u];
        tileScales[tile] = exp(tileMaximum - maximum);
    }
    barrier();

    for (uint h = lane; h < hiddenSize; h += N_THREADS) {
        float value = 0.0f;
        for (uint tile = 0u; tile < tileCount; ++tile)
            value += tileScales[tile] * partials[info.inputOffset + tile * physicalSize + h];
        outputValues[mixOffset + h] = value;
    }
    if (lane == 0u) {
        float denominator = 0.0f;
        for (uint tile = 0u; tile < tileCount; ++tile)
            denominator += tileScales[tile] *
                partials[info.inputOffset + tile * physicalSize + hiddenSize];
        outputValues[mixOffset + hiddenSize] = denominator;
        vocabularyMaximum[info.outputOffset] = maximum;
    }
    for (uint h = hiddenSize + 1u + lane; h < physicalSize; h += N_THREADS)
        outputValues[mixOffset + h] = 0.0f;
}
