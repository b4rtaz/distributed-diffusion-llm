#version 450

#extension GL_EXT_shader_8bit_storage : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_shader_explicit_arithmetic_types : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable

#define N_THREADS 32
#define BLOCK_SIZE 32

layout(local_size_x = N_THREADS, local_size_y = 1, local_size_z = 1) in;

layout(constant_id = 0) const uint N_BATCHES = 32;
layout(constant_id = 1) const uint HIDDEN_SIZE = 32;

struct BatchInfo {
    uint inputOffset;
    uint inputSizeX;
    uint outputOffset;
    uint outputSizeX;
};

struct BlockQ80 {
    float16_t d;
    int8_t qs[BLOCK_SIZE];
};

struct BlockQ40 {
    float16_t d;
    uint8_t qs[BLOCK_SIZE / 2];
};

layout(binding = 0) readonly buffer inputBuffer { BlockQ80 hidden[]; };
layout(binding = 1) writeonly buffer outputBuffer { float logits[]; };
layout(binding = 2) readonly uniform batchInfosBuffer { BatchInfo infos[N_BATCHES]; };
layout(binding = 3) readonly buffer weightBuffer { BlockQ40 embedding[]; };
layout(binding = 4) readonly uniform configBuffer {
    uint mode;
    uint embeddingMixBufferIndex;
    uint vocabularyMaxPipeIndex;
    uint globalMaxBufferIndex;
    uint temperaturePipeIndex;
    uint nodeIndex;
    uint nNodes;
    uint physicalSize;
    float embeddingScale;
    float logitSoftcap;
    uint useTemperature;
    uint partialBufferIndex;
    uint tileSize;
    uint tileCount;
    uint hiddenSize;
};
layout(binding = 5) writeonly buffer partialBuffer { float partials[]; };
layout(binding = 6) readonly buffer temperatureBuffer { float temperature[]; };

shared float decodedRow[HIDDEN_SIZE];
shared float numerator[HIDDEN_SIZE];
shared float subgroupSums[N_THREADS];
shared float runningMaximum;
shared float denominator;
shared float oldScale;
shared float valueScale;

void main() {
    const uint tile = gl_WorkGroupID.x;
    const uint batch = gl_WorkGroupID.y;
    const uint lane = gl_LocalInvocationID.x;
    const BatchInfo info = infos[batch];
    const uint rowBlocks = HIDDEN_SIZE / BLOCK_SIZE;
    const uint tokenStart = tile * tileSize;
    const uint tokenEnd = min(tokenStart + tileSize, info.outputSizeX);
    const uint partialOffset = (batch * tileCount + tile) * physicalSize;
    const float inverseTemperature = 1.0f / temperature[0];

    for (uint h = lane; h < HIDDEN_SIZE; h += N_THREADS)
        numerator[h] = 0.0f;
    barrier();

    for (uint token = tokenStart; token < tokenEnd; ++token) {
        float sum = 0.0f;
        for (uint blockIndex = lane; blockIndex < rowBlocks; blockIndex += N_THREADS) {
            const BlockQ40 weightBlock = embedding[token * rowBlocks + blockIndex];
            const BlockQ80 inputBlock = hidden[info.inputOffset + blockIndex];
            const float weightScale = float(weightBlock.d);
            int quantizedSum = 0;
            for (uint i = 0u; i < BLOCK_SIZE / 2u; ++i) {
                const uint packed = weightBlock.qs[i];
                const int low = int(packed & 0xFu) - 8;
                const int high = int(packed >> 4u) - 8;
                decodedRow[blockIndex * BLOCK_SIZE + i] = weightScale * float(low);
                decodedRow[blockIndex * BLOCK_SIZE + i + BLOCK_SIZE / 2u] =
                    weightScale * float(high);
                quantizedSum += low * int(inputBlock.qs[i]);
                quantizedSum += high * int(inputBlock.qs[i + BLOCK_SIZE / 2u]);
            }
            sum += float(quantizedSum) * float(inputBlock.d) * weightScale;
        }
        const float subgroupSum = subgroupAdd(sum);
        if (subgroupElect())
            subgroupSums[gl_SubgroupID] = subgroupSum;
        barrier();

        if (lane == 0u) {
            float rawLogit = 0.0f;
            for (uint subgroupIndex = 0u; subgroupIndex < gl_NumSubgroups; ++subgroupIndex)
                rawLogit += subgroupSums[subgroupIndex];
            const float logit = logitSoftcap * tanh(rawLogit / logitSoftcap);
            logits[info.outputOffset + token] = logit;
            const float score = logit * inverseTemperature;
            if (token == tokenStart) {
                runningMaximum = score;
                denominator = 1.0f;
                oldScale = 0.0f;
                valueScale = 1.0f;
            } else if (score > runningMaximum) {
                oldScale = exp(runningMaximum - score);
                runningMaximum = score;
                denominator = denominator * oldScale + 1.0f;
                valueScale = 1.0f;
            } else {
                oldScale = 1.0f;
                valueScale = exp(score - runningMaximum);
                denominator += valueScale;
            }
        }
        barrier();

        for (uint blockIndex = lane; blockIndex < rowBlocks; blockIndex += N_THREADS)
            for (uint i = 0u; i < BLOCK_SIZE; ++i) {
                const uint h = blockIndex * BLOCK_SIZE + i;
                numerator[h] = numerator[h] * oldScale + decodedRow[h] * valueScale;
            }
    }

    for (uint h = lane; h < HIDDEN_SIZE; h += N_THREADS)
        partials[partialOffset + h] = numerator[h];
    if (lane == 0u) {
        partials[partialOffset + HIDDEN_SIZE] = denominator;
        partials[partialOffset + HIDDEN_SIZE + 1u] = runningMaximum;
    }
    for (uint h = HIDDEN_SIZE + 2u + lane; h < physicalSize; h += N_THREADS)
        partials[partialOffset + h] = 0.0f;
}
