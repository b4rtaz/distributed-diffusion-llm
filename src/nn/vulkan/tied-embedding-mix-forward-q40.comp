#version 450
#extension GL_GOOGLE_include_directive : require
#include "tied-embedding-q40.glsl"

// Eight canvas rows by 32 hidden columns. The converter stores the embedding
// to [hidden, vocabulary], so each lane reads a contiguous Q40 vocabulary row.
layout(local_size_x = 128) in;
shared float weights[32][33];
shared float probs[8][32];

void main() {
    const uint lane = gl_LocalInvocationID.x;
    const uint h = lane % 32u;
    const uint b = lane / 32u;
    const uint hiddenBlockCount = HIDDEN_SIZE / 32u;
    const uint tile = gl_WorkGroupID.x / hiddenBlockCount;
    const uint hiddenBlock = gl_WorkGroupID.x % hiddenBlockCount;
    const uint batch = gl_WorkGroupID.y * 8u;
    const uint tokenStart = tile * tileSize;
    const uint tokenEnd = min(tokenStart + tileSize, infos[batch].outputSizeX);
    const uint vocabBlockCount = (infos[batch].outputSizeX + 31u) / 32u;
    const uint hidden = hiddenBlock * 32u + h;
    float sum0 = 0.0f, sum1 = 0.0f;
    const uint firstVocabBlock = tokenStart / 32u;
    const uint lastVocabBlock = (tokenEnd + 31u) / 32u;
    for (uint vocabBlock = firstVocabBlock; vocabBlock < lastVocabBlock; ++vocabBlock) {
        const uint blockStart = vocabBlock * 32u;
        const uint firstToken = max(tokenStart, blockStart);
        const uint lastToken = min(tokenEnd, blockStart + 32u);
        const BlockQ40 weight = embedding[hidden * vocabBlockCount + vocabBlock];
        const float scale = float(weight.d);
        for (uint i = b * 4u; i < b * 4u + 4u; ++i) {
            const uint packed = weight.qs[i & 15u];
            weights[i][h] = scale * float(int(packed & 15u) - 8);
            weights[i + 16u][h] = scale * float(int(packed >> 4u) - 8);
        }
        const uint token = blockStart + h;
        const bool inTile = token >= firstToken && token < lastToken;
        probs[b][h] = inTile && batch + b < batchSize
            ? probabilities[infos[batch + b].outputOffset + token] : 0.0f;
        probs[b + 4u][h] = inTile && batch + b + 4u < batchSize
            ? probabilities[infos[batch + b + 4u].outputOffset + token] : 0.0f;
        barrier();
        for (uint i = 0u; i < 32u; ++i) {
            const float value = weights[i][h];
            sum0 += probs[b][i] * value;
            sum1 += probs[b + 4u][i] * value;
        }
        barrier();
    }
    if (batch + b < batchSize)
        partials[((batch + b) * tileCount + tile) * physicalSize + hidden] = sum0;
    if (batch + b + 4u < batchSize)
        partials[((batch + b + 4u) * tileCount + tile) * physicalSize + hidden] = sum1;
}
