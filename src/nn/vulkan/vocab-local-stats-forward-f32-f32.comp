#version 450

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(constant_id = 0) const uint N_BATCHES = 32;

#define VOCAB_STATS_WIDTH 5u

struct BatchInfo {
    uint inputOffset;
    uint inputSizeX;
    uint outputOffset;
    uint outputSizeX;
};

layout(binding = 0) readonly buffer inputBuffer { float x[]; };
layout(binding = 1) writeonly buffer outputBuffer { float y[]; };
layout(binding = 2) readonly uniform batchInfosBuffer { BatchInfo infos[N_BATCHES]; };
layout(binding = 3) readonly uniform configBuffer {
    uint globalMaxBufferIndex;
    uint temperaturePipeIndex;
    uint targetTokensPipeIndex;
    uint vocabStart;
    uint microshardCount;
    uint useTargetTokens;
};
layout(binding = 4) readonly buffer globalMaxBuffer { float globalMax[]; };
layout(binding = 5) readonly buffer temperatureBuffer { float temperature[]; };
layout(binding = 6) readonly buffer targetTokensBuffer { float targetTokens[]; };

void kahanAdd(const float value, inout float sum, inout float correction) {
    const float adjusted = value - correction;
    const float next = sum + adjusted;
    correction = (next - sum) - adjusted;
    sum = next;
}

void main() {
    const uint batchIndex = gl_WorkGroupID.y;
    const BatchInfo info = infos[batchIndex];
    const uint localShard = gl_WorkGroupID.x;
    const uint microshardSize = info.inputSizeX / microshardCount;
    const uint start = localShard * microshardSize;
    const uint end = start + microshardSize;
    const float inverseTemperature = 1.0f / temperature[0];
    const float maximum = globalMax[batchIndex];
    float denominator = 0.0f;
    float denominatorCorrection = 0.0f;
    float moment = 0.0f;
    float momentCorrection = 0.0f;
    float localMaximum = -3.402823466e+38f;
    uint argmax = start;
    for (uint token = start; token < end; ++token) {
        const float logit = x[info.inputOffset + token];
        if (logit > localMaximum) {
            localMaximum = logit;
            argmax = token;
        }
        const float shifted = logit * inverseTemperature - maximum;
        const float weight = exp(shifted);
        kahanAdd(weight, denominator, denominatorCorrection);
        kahanAdd(weight * shifted, moment, momentCorrection);
    }
    const uint recordOffset = info.outputOffset + localShard * VOCAB_STATS_WIDTH;
    y[recordOffset] = denominator;
    y[recordOffset + 1u] = moment;
    y[recordOffset + 2u] = localMaximum;
    y[recordOffset + 3u] = float(vocabStart + argmax);
    y[recordOffset + 4u] = uintBitsToFloat(0xff800000u);
    if (useTargetTokens != 0u) {
        const uint target = uint(targetTokens[batchIndex]);
        const uint globalStart = vocabStart + start;
        const uint globalEnd = vocabStart + end;
        if (target >= globalStart && target < globalEnd)
            y[recordOffset + 4u] = x[info.inputOffset + target - vocabStart];
    }
}
